{
  "name": "decoupled-components",
  "version": "0.1.0",
  "description": "Component showcase starter demonstrating paragraph-style components with Drupal CMS",
  "private": true,
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "npx decoupled-cli@2.14.1 setup --content data/components-content.json",
    "setup-content": "npx decoupled-cli@2.14.1 content import --file data/components-content.json",
    "setup-content:preview": "npx decoupled-cli@2.14.1 content import --file data/components-content.json --preview",
    "sync-schema": "npx decoupled-cli@2.14.1 schema sync",
    "build:cloudflare": "opennextjs-cloudflare build"